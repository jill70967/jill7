<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Cloud Telepathy | Real-Time Mind Sync Game</title>
  
  <!-- Google Fonts: Inter & Noto Sans TC -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Noto+Sans+TC:wght@400;500;700;900&display=swap" rel="stylesheet">
  
  <!-- Font Awesome Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

  <style>
    /* =========================================================
       1. Global Theme Variables (Soft Pink Glassmorphism)
       ========================================================= */
    :root {
      --bg-gradient: linear-gradient(135deg, #ff9a9e 0%, #fecfef 50%, #fef9d7 100%);
      --glass-bg: rgba(255, 255, 255, 0.90);
      --glass-border: rgba(255, 255, 255, 0.85);
      --primary-pink: #ff6b81;
      --accent-orange: #ff8e53;
      --text-dark: #2c3e50;
      --text-muted: #718096;
      --shadow-pink: rgba(235, 100, 120, 0.22);
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: 'Inter', 'PingFang TC', 'Noto Sans TC', -apple-system, sans-serif;
      background: var(--bg-gradient);
      background-attachment: fixed;
      color: var(--text-dark);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      padding: 20px 16px;
      position: relative;
      overflow-x: hidden;
    }

    /* Ambient Floating Orbs */
    .bg-orb {
      position: fixed;
      border-radius: 50%;
      filter: blur(70px);
      z-index: 0;
      pointer-events: none;
      animation: orbFloat 10s infinite alternate ease-in-out;
    }

    .orb-1 {
      width: 320px;
      height: 320px;
      background: rgba(255, 107, 129, 0.3);
      top: -40px;
      left: -40px;
    }

    .orb-2 {
      width: 360px;
      height: 360px;
      background: rgba(254, 207, 239, 0.55);
      bottom: -60px;
      right: -40px;
      animation-delay: -4s;
    }

    @keyframes orbFloat {
      0% { transform: translate(0, 0) scale(1); }
      100% { transform: translate(35px, 40px) scale(1.1); }
    }

    /* Header Bar */
    header {
      width: 100%;
      max-width: 900px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 16px 20px;
      background: var(--glass-bg);
      backdrop-filter: blur(14px);
      border-radius: 24px;
      border: 1px solid var(--glass-border);
      box-shadow: 0 10px 25px var(--shadow-pink);
      margin-bottom: 24px;
      z-index: 1;
    }

    .header-logo {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .logo-icon {
      width: 42px;
      height: 42px;
      border-radius: 14px;
      background: linear-gradient(135deg, #ff6b81, #ff8e53);
      color: white;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.25rem;
      box-shadow: 0 4px 12px rgba(255, 107, 129, 0.35);
    }

    .logo-text h1 {
      font-size: 1.25rem;
      font-weight: 800;
      color: #ff6b81;
      letter-spacing: 0.5px;
    }

    .logo-text p {
      font-size: 0.75rem;
      color: var(--text-muted);
      font-weight: 600;
    }

    .room-badges {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .badge-item {
      font-size: 0.8rem;
      font-weight: 600;
      background: #ffffff;
      padding: 6px 14px;
      border-radius: 20px;
      border: 1px solid #ffe0e6;
      color: var(--text-dark);
      box-shadow: 0 2px 8px rgba(0,0,0,0.03);
    }

    .badge-item strong {
      color: var(--primary-pink);
    }

    .gear-btn {
      background: #ffffff;
      border: 1px solid #ffe0e6;
      color: var(--text-muted);
      width: 34px;
      height: 34px;
      border-radius: 12px;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: all 0.2s ease;
    }

    .gear-btn:hover {
      color: var(--primary-pink);
      border-color: var(--primary-pink);
      transform: rotate(30deg);
    }

    /* Main Container */
    main {
      width: 100%;
      max-width: 900px;
      flex-grow: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
      z-index: 1;
    }

    /* Stage 1: Login Card */
    #sec-login {
      width: 100%;
      max-width: 440px;
      background: var(--glass-bg);
      backdrop-filter: blur(16px);
      border-radius: 30px;
      padding: 36px 28px;
      border: 1px solid var(--glass-border);
      box-shadow: 0 15px 35px var(--shadow-pink);
      margin: auto;
      text-align: center;
    }

    #sec-login h2 {
      font-size: 1.6rem;
      font-weight: 800;
      color: #2c3e50;
      margin-bottom: 6px;
    }

    #sec-login p {
      font-size: 0.85rem;
      color: var(--text-muted);
      margin-bottom: 24px;
    }

    .form-group {
      text-align: left;
      margin-bottom: 18px;
    }

    .form-group label {
      display: block;
      font-size: 0.78rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.8px;
      color: var(--primary-pink);
      margin-bottom: 6px;
    }

    .input-row {
      display: flex;
      gap: 8px;
    }

    input[type="text"] {
      width: 100%;
      padding: 12px 16px;
      background: #ffffff;
      border: 1px solid #ffe0e6;
      border-radius: 14px;
      font-size: 0.92rem;
      color: var(--text-dark);
      outline: none;
      transition: all 0.25s ease;
    }

    input[type="text"]:focus {
      border-color: var(--primary-pink);
      box-shadow: 0 0 0 3px rgba(255, 107, 129, 0.15);
    }

    .btn-secondary {
      background: #ffffff;
      border: 1px solid #ffe0e6;
      color: var(--text-dark);
      padding: 12px 16px;
      border-radius: 14px;
      font-weight: 700;
      font-size: 0.85rem;
      cursor: pointer;
      white-space: nowrap;
      transition: all 0.25s ease;
    }

    .btn-secondary:hover {
      background: #ffe4e8;
